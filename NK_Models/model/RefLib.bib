@Article{Kilian2022,
  author   = {Lutz Kilian},
  title    = {Understanding the Estimation of Oil Demand and Oil Supply Elasticities},
  journal  = {Energy Economics},
  year     = {2022},
  volume   = {107},
  pages    = {105844},
  issn     = {0140-9883},
  abstract = {This paper examines the advantages and drawbacks of alternative methods of estimating oil supply and oil demand elasticities and of incorporating this information into structural VAR models of the global oil market. I show that some of these methodologies suffer from drawbacks that call into question the estimates they generate. I also explain the rationale for the use of alternative elasticity definitions in the literature and discuss the trade-off between these definitions. Once these issues are recognized, seemingly conflicting conclusions in the recent literature can be reconciled. My analysis reaffirms the conclusion that the one-month oil supply elasticity is close to zero, which implies that oil demand shocks are the dominant driver of the real price of oil.},
  doi      = {https://doi.org/10.1016/j.eneco.2022.105844},
  file     = {Kilian2022.pdf:Commodities\\Kilian2022.pdf:PDF},
  keywords = {Oil supply elasticity, Oil demand elasticity, IV estimation, Structural VAR, Bayesian inference, Oil price, Gasoline price},
