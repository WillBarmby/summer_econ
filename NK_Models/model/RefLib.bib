@Article{ChenTillmann2021,
  author   = {Chen, Hongyi and Tillmann, Peter},
  title    = {{Monetary Policy Uncertainty in China}},
  journal  = {Journal of International Money and Finance},
  year     = {2021},
  volume   = {110},
  number   = {C},
  abstract = {We propose a new measure of uncertainty about the monetary policy of the People�s Bank of China (PBOC). The uncertainty index is extracted from the reporting about the PBOC's monetary policy in international newspapers. A shock to Chinese monetary policy uncertainty has significant effects on economic activity in mainland China. An increase in monetary policy uncertainty leads to a strong fall in investment, GDP and prices. We also show that a monetary policy uncertainty shock originating in mainland China has strong spillover effects on other Asian economies, leading to a fall in asset prices and GDP. An increase in reporting about uncertainty in international newspapers leads to a drop in stock prices throughout the region. Hence, uncertainty about the PBOC's monetary policy is an additional channel of transmission that coexists with the transmission of PBOC monetary policy itself. Finally, we show that our index contains information over and above what is already incorporated in monetary policy uncertainty indices based on mainland newspapers.},
  doi      = {https://doi.org/10.1016/j.jimonfin.2020.1},
  file     = {ChenTillmann2021.pdf:Economic Uncertainty\\ChenTillmann2021.pdf:PDF},
  keywords = {Monetary policy uncertainty; China; VAR; Spillover; Newspapers; Emerging markets},
  url      = {https://ideas.repec.org/a/eee/jimfin/v110y2021ics0261560620302655.html},
}

@Article{GaoEtAl2022,
  author   = {Gao, Lin and Hitzemann, Steffen and Shaliastovich, Ivan and Xu, Lai},
  journal  = {Journal of Financial Economics},
  title    = {{Oil Volatility Risk}},
  year     = {2022},
  number   = {2},
  pages    = {456-491},
  volume   = {144},
  abstract = {The option-implied oil price volatility is a strong negative predictor of economic growth beyond traditional uncertainty measures. A rise in oil volatility also predicts an increase in oil inventories and a reduction in oil consumption, in line with a propagation channel through the oil sector. We explain these findings within a macro-finance model featuring stochastic uncertainties and precautionary oil inventories: firms increase oil inventories when oil volatility rises, which curbs oil use for production and depresses economic activity. In the model and the data, aggregate equity prices fall at times of high oil volatility, with differential exposures across economic sectors.},
  doi      = {https://doi.org/10.1016/j.jfineco.2021.08.016},
  file     = {GaoEtAl2022.pdf:Commodities\\GaoEtAl2022.pdf:PDF},
  keywords = {Oil volatility; Oil inventory; Production economy},
  url      = {https://ideas.repec.org/a/eee/jfinec/v144y2022i2p456-491.html},
}

@Article{Larsen2021,
  author   = {Vegard H{\o}ghaug Larsen},
  title    = {{Components of Uncertainty}},
  journal  = {International Economic Review},
  year     = {2021},
  volume   = {62},
  number   = {2},
  pages    = {769-788},
  month    = {May},
  abstract = {Uncertainty is acknowledged to be a source of economic fluctuations. But, does the type of uncertainty matter for the economy's response to an uncertainty shock? This article offers a novel identification strategy to disentangle different types of uncertainty. It uses machine learning techniques to classify different types of news instead of specifying a set of keywords. The article finds that, depending on its source, the effects of uncertainty on a macroeconomic variable may differ. I find that both good (expansionary effect) and bad (contractionary effect) types of uncertainty exist.},
  doi      = {https://doi.org/10.1111/iere.12499},
  file     = {Larsen2021.pdf:Economic Uncertainty\\Larsen2021.pdf:PDF},
  url      = {https://ideas.repec.org/a/wly/iecrev/v62y2021i2p769-788.html},
}

@Article{SmiechEtAl2021,
  author   = {\'{S}miech, S{\l}awomir and Papie\.{z}, Monika and Rubaszek, Micha{\l} and Snarska, Ma{\l}gorzata},
  title    = {{The Role of Oil Price Uncertainty Shocks on Oil-Exporting Countries}},
  journal  = {Energy Economics},
  year     = {2021},
  volume   = {93},
  number   = {C},
  abstract = {This paper examines the effect of oil price uncertainty on industrial production and the exchange rates in four oil exporting countries, Canada, Mexico, Norway and Russia. Within the block-exogenous Bayesian SVAR framework we find that the oil price uncertainty shocks result in a persistent drop of industrial production, which is heterogeneous in its depth across the analysed countries. The exchange rate depreciates instantly in reaction to the oil price uncertainty shock, but this reaction is long-lasting only in the case of developing countries, Mexico and Russia. We show that oil price uncertainty shocks is an important driver of industrial production fluctuations in all oil exporting countries, whereas the contribution of these shocks to exchange rate fluctuations varies from country to country and is greatest in Mexico and the lowest for Norway.},
  doi      = {https://doi.org/10.1016/j.eneco.2020.1050},
  file     = {SmiechEtAl2021.pdf:Commodities\\SmiechEtAl2021.pdf:PDF},
  keywords = {Oil-exporting countries; Oil price uncertainty; Bayesian SVAR model},
  url      = {https://ideas.repec.org/a/eee/eneeco/v93y2021ics0140988320303686.html},
}

@Unpublished{BerajaWolf2021,
  author   = {Martin Beraja and Christian K. Wolf},
  title    = {{Demand Composition and the Strength of Recoveries}},
  note     = {NBER Working Paper 29304},
  month    = {September},
  year     = {2021},
  abstract = {We argue that recoveries from demand-driven recessions with expenditure cuts concentrated in services or non-durables will tend to be weaker than recoveries from recessions more biased towards durables. Intuitively, the smaller the bias towards more durable goods, the less the recovery is buffeted by pent-up demand. We show that, in a standard multi-sector business-cycle model, this prediction holds if and only if, following an aggregate demand shock to all categories of spending (e.g., a monetary shock), expenditure on more durable goods reverts back faster. This testable condition receives ample support in U.S. data. We then use (i) a semi-structural shift-share and (ii) a structural model to quantify this effect of varying demand composition on recovery dynamics, and find it to be large. We also discuss implications for optimal stabilization policy.},
  doi      = {https://doi.org/10.3386/w29304},
  file     = {BerajaWolf2021.pdf:Business Cycles and Real Frictions\\BerajaWolf2021.pdf:PDF},
  url      = {https://ideas.repec.org/p/nbr/nberwo/29304.html},
}

@Unpublished{AhirEtAl2022,
  author   = {Hites Ahir and Nicholas Bloom and Davide Furceri},
  title    = {{The World Uncertainty Index}},
  note     = {NBER Working Paper 29763},
  month    = {February},
  year     = {2022},
  abstract = {We construct the World Uncertainty Index (WUI) for an unbalanced panel of 143 individual countries on a quarterly basis from 1952. This is the frequency of the word �uncertainty� in the quarterly Economist Intelligence Unit country reports. Globally, the Index spikes around major events like the Gulf War, the Euro debt crisis, the Brexit vote and the COVID pandemic. The level of uncertainty is higher in developing countries but is more synchronized across advanced economies with their tighter trade and financial linkages. In a panel vector autoregressive setting we find that innovations in the WUI foreshadow significant declines in output. This effect is larger and more persistent in countries with lower institutional quality, and in sectors with greater financial constraints.},
  doi      = {https://doi.org/10.3386/w29763},
  file     = {AhirEtAl2022.pdf:Economic Uncertainty\\AhirEtAl2022.pdf:PDF},
  url      = {https://ideas.repec.org/p/nbr/nberwo/29763.html},
}

