@Article{MorandReffett2003,
  author     = {Morand, Olivier F. and Reffett, Kevin L.},
  title      = {Existence and uniqueness of equilibrium in nonoptimal unbounded infinite horizon economies},
  journal    = {Journal of Monetary Economics},
  year       = {2003},
  volume     = {50},
  number     = {6},
  pages      = {1351--1373},
  month      = {September},
  abstract   = {In applied work in macroeconomics and finance, nonoptimal infinite
	horizon economies are often studied in which the state-space is unbounded.
	Important examples of such economies are single-sector growth models
	with production externalities, valued fiat money, monopolistic competition,
	and/or distortionary government taxation. Although sufficient conditions
	for existence and uniqueness of Markovian equilibrium are weIl known
	for the compact state space case, no similar sufficient conditions
