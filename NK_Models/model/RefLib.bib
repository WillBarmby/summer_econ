@Article{BornPfeifer2021,
  author  = {Benjamin Born and Johannes Pfeifer},
  title   = {{Uncertainty Driven Business Cycles: Assessing the Markup Channel}},
  journal = {Quantitative Economics},
  year    = {2021},
  volume  = {12},
  number  = {2},
  pages   = {587-623},
  month   = {May},
