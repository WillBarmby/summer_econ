  author  = {Atkeson, Andrew and Kehoe, Patrick J.},
  journal = {American Economic Review},
  title   = {Models of Energy Use: Putty-Putty versus Putty-Clay},
  year    = {1999},
  month   = {September},
  number  = {4},
