@Article{MasonJayadev2014,
  author   = {J. W. Mason and Arjun Jayadev},
  title    = {``Fisher Dynamics'' in US Household Debt, 1929-2011},
  journal  = {American Economic Journal: Macroeconomics},
  year     = {2014},
  volume   = {6},
  number   = {3},
  pages    = {214-234},
  month    = {July},
  abstract = {The evolution of debt-income ratios over time depends on income growth, inflation, and interest rates, independent of any changes in borrowing. We examine the effect of these \&quot;Fisher dynamics\&quot; on household debt-income ratios in the United States over the period 1929?2011. Adapting a standard decomposition of public debt to household sector debt, we show that these factors explain, in accounting terms, a large fraction of the changes in household debt-income ratios observed historically. More recently, debt defaults have also been important. Changes in household debt-income ratios over time cannot be straightforwardly interpreted as reflecting shifts in the supply and demand of household credit.},
  file     = {MasonJayadev2014.pdf:Fiscal Policy\\MasonJayadev2014.pdf:PDF},
  url      = {https://ideas.repec.org/a/aea/aejmac/v6y2014i3p214-34.html},
}

