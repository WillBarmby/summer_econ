@Article{BlanchardGali2007,
  author   = {Olivier Blanchard and Jordi Gali},
  journal  = {Journal of Money, Credit and Banking},
  title    = {{Real Wage Rigidities and the New Keynesian Model}},
  year     = {2007},
  month    = {February},
  number   = {s1},
  pages    = {35-65},
  volume   = {39},
  abstract = {Most central banks perceive a trade-off between stabilizing inflation and stabilizing the gap between output and desired output. However, the standard new Keynesian framework implies no such trade-off. In that framework, stabilizing inflation is equivalent to stabilizing the welfare-relevant output gap. In this paper, we argue that this property of the new Keynesian framework, which we call the \&quot;divine coincidence\&quot;, is due to a special feature of the model: the absence of nontrivial \&quot;real\&quot; imperfections. We focus on one such real imperfection, namely, real wage rigidities. When the baseline new Keynesian model is extended to allow for real wage rigidities, the divine coincidence disappears, and central banks indeed face a trade-off between stabilizing inflation and stabilizing the welfare-relevant output gap. We show that not only does the extended model have more realistic normative implications, but it also has appealing positive properties. In particular, it provides a natural interpretation for the dynamic inflation-unemployment relation found in the data. Copyright 2007 The Ohio State University.},
  doi      = {https://doi.org/10.1111/j.1538-4616.2007.00015.x},
  file     = {BlanchardGali2007.pdf:Search\\BlanchardGali2007.pdf:PDF},
  url      = {https://ideas.repec.org/a/mcb/jmoncb/v39y2007is1p35-65.html},
}

@Article{HamanoZanetti2017,
  author   = {Masashige Hamano and Francesco Zanetti},
  title    = {{Endogenous Turnover and Macroeconomic Dynamics}},
  journal  = {Review of Economic Dynamics},
  year     = {2017},
  volume   = {26},
  pages    = {263-279},
  month    = {October},
  abstract = {This paper introduces endogenous product entry and exit based on creation and destruction of product variety in a general equilibrium model. Recessionary technology shocks induce exit of unprofitable products on impact, allocating resources towards more productive production lines. However, during the recovery phase, less productive production lines survive destruction, counteracting the original increase in productivity. The analysis shows that recoveries hinge on lower product destruction rather than higher product creation. We find that product heterogeneity and the persistence of technology shocks play a critical role for the cyclicality of product turnover. Endogenous product destruction is important to evaluate the effect of permanent policies of entry deregulation and subsidies aimed to stimulate the economy. (Copyright: Elsevier)},
  doi      = {https://doi.org/10.1016/j.red.2017.06.003},
  file     = {HamanoZanetti2017.pdf:Search\\HamanoZanetti2017.pdf:PDF},
  keywords = {Product heterogeneity; Endogenous product destruction; Business cycles},
  url      = {https://ideas.repec.org/a/red/issued/15-258.html},
}

