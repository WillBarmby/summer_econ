@Article{FernandezVillaverdeEtAl2011,
  author   = {Jes\'{u}s Fern\'{a}ndez-Villaverde and Pablo Guerr\'{o}n-Quintana and Juan F. Rubio-Ram\'{i}rez and Martin Uribe},
  journal  = {American Economic Review},
  title    = {Risk Matters: The Real Effects of Volatility Shocks},
  year     = {2011},
  month    = {October},
  number   = {6},
  pages    = {2530-61},
  volume   = {101},
  abstract = {We show how changes in the volatility of the real interest rate at
	which small open emerging economies borrow have an important effect
	on variables like output, consumption, investment, and hours. We
	start by documenting the strong evidence of time-varying volatility
	in the real interest rates faced by four emerging economies: Argentina,
	Brazil, Ecuador, and Venezuela. We estimate a stochastic volatility
	process for real interest rates. Then, we feed this process in a
	standard small open economy business cycle model. We find that an
	increase in real interest rate volatility triggers a fall in output,
	consumption, investment, hours, and debt. (JEL E13, E20, E32, E43,
	F32, F43, 011)},
  doi      = {https://doi.org/10.1257/aer.101.6.2530},
  file     = {FernandezVillaverdeEtAl2011.pdf:Stochastic Volatility\\FernandezVillaverdeEtAl2011.pdf:PDF},
  url      = {http://ideas.repec.org/a/aea/aecrev/v101y2011i6p2530-61.html},
}

